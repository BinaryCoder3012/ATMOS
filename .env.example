# AWS Sync Configuration
AWS_SYNC_ENDPOINT=https://your-aws-api-gateway-url.execute-api.ap-south-1.amazonaws.com/prod/attendance/sync
AWS_API_KEY=your_aws_api_key_here

# App Configuration
APP_ENV=development
DEMO_MODE=true
SIMILARITY_THRESHOLD=0.85
EAR_BLINK_THRESHOLD=0.20
MAR_SMILE_THRESHOLD=0.60
LIVENESS_BLINK_COUNT=1
LIVENESS_TIMEOUT_MS=10000
